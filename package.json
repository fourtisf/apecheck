{
  "name": "apecheck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "db:generate": "pnpm --filter @apecheck/db generate",
    "db:migrate": "pnpm --filter @apecheck/db migrate:dev",
    "db:deploy": "pnpm --filter @apecheck/db migrate:deploy",
    "e2e": "pnpm --filter @apecheck/worker e2e"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "bufferutil",
      "utf-8-validate"
    ]
  }
}
