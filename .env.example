# ───────── App ─────────
NODE_ENV=production
APP_URL=https://apecheck.io
API_URL=https://api.apecheck.io
SESSION_SECRET=change-me-64-random-chars
CORS_ORIGINS=https://apecheck.io,https://www.apecheck.io
# how processes on the server reach each other (web → api, workers → web for share cards)
API_INTERNAL_URL=http://127.0.0.1:4000
WEB_INTERNAL_URL=http://127.0.0.1:3000
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# the browser bundle reads these at build time (keep in sync with API_URL / APP_URL)
NEXT_PUBLIC_API_URL=https://api.apecheck.io
NEXT_PUBLIC_APP_URL=https://apecheck.io

# ───────── Database / cache ─────────
DATABASE_URL=postgresql://apecheck:CHANGE_ME@localhost:5432/apecheck
REDIS_URL=redis://localhost:6379

# ───────── AI (Anthropic Claude API) ─────────
ANTHROPIC_API_KEY=               # empty = heuristic stand-in for the AI stages (logged as a warning)
AI_BASE_URL=                     # optional; defaults to https://api.anthropic.com
AI_MODEL_JUDGE=claude-sonnet-5-5     # browser exploration + judging claims + bot follow-ups
AI_MODEL_FAST=claude-haiku-5-5       # claim extraction, classification
CHECK_BUDGET_SECONDS=180
CHECK_MAX_AGENT_ACTIONS=6
MAX_CONCURRENT_BROWSERS=2
CACHE_HOURS=6
SCREENSHOT_DIR=/var/apecheck/shots
OUTBOUND_PROXY=                  # optional egress proxy for Chromium + server fetches (leave empty on the VPS)
SSRF_ALLOW_HOSTS=                # DEV/TEST ONLY: host:port list the SSRF guard lets through (ignored in production)
# Isolated browser host (DEPLOY.md §6). Production: deploy/browser/install.sh fills in BROWSER_WS_ENDPOINT
# (ws://127.0.0.1:9223/<secret>) and worker-checks refuses to start without it. Empty in dev: Chromium runs in-process.
BROWSER_WS_ENDPOINT=
BROWSER_GUARD_PORT=9224          # the SSRF guard's port, the only one the browser user's firewall allows (browser-firewall.nft)

# ───────── X (bot account @ApeCheckBot, OAuth 1.0a user context; setup: DEPLOY.md §14) ─────────
X_API_KEY=                     # consumer key of the developer app (Read and write)
X_API_SECRET=                  # consumer secret
X_ACCESS_TOKEN=                # access token of the BOT account (generated after setting Read and write)
X_ACCESS_SECRET=
X_BEARER_TOKEN=                # app-only reads (posts, accounts) during checks
X_BOT_USER_ID=                 # numeric id of the bot account (GET /2/users/by/username/<handle>)
X_BOT_HANDLE=ApeCheckBot       # without @
X_OAUTH2_CLIENT_ID=            # "link your X" sign-in for users (optional, M3)
X_OAUTH2_CLIENT_SECRET=
BOT_POLL_SECONDS=20            # mentions poll interval (owned read)
BOT_USER_HOURLY=3              # replies per X account per hour (free)
BOT_PRO_USER_HOURLY=20         # ... for accounts linked to a Pro/Max wallet
BOT_HOURLY_CAP=200             # replies per hour for the whole bot (bounds the posting bill)
BOT_INCLUDE_LINK=false         # posts with a URL are billed higher by X; enable after checking cost
# X_BOT_DEV=1                  # dev only: run the bot inside `pnpm dev` (off by default; use a TEST bot account's keys,
                               # never the server's: the server's one-bot lock can't see a local Redis)

# ───────── Chain data ─────────
HELIUS_API_KEY=                # Solana
ETHERSCAN_API_KEY=             # Etherscan V2 (one key, many EVM chains)
TRONGRID_API_KEY=
RPC_SOLANA=
RPC_ETH=
RPC_BASE=
RPC_BSC=
RPC_ARB=
RPC_ROBINHOOD=                 # Robinhood Chain RPC
DEXSCREENER_BASE=https://api.dexscreener.com

# ───────── Fourtis internal (DevRadar, BundleScan, WhaleFlow) ─────────
FOURTIS_API_URL=
FOURTIS_API_KEY=

# ───────── GitHub ─────────
GITHUB_TOKEN=

# ───────── Access tiers ─────────
FREE_CHECKS_PER_DAY=5
TOKEN_CHAIN=sol
TOKEN_ADDRESS=                 # empty = token not live, holding tiers hidden
PRO_MIN_HOLD=250000
MAX_MIN_HOLD=2500000
PRO_CHECKS_PER_DAY=30
MAX_CHECKS_PER_DAY=200
